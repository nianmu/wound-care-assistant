# ===== 大模型（多模型可切换，均走 OpenAI 兼容接口）=====
# 默认 LLM：硅基流动 DeepSeek V3.2
# ⚠️ DEFAULT_MODEL 必须填 models.yaml 里的 **id**（如 deepseek-chat），
#    不是模型全名（deepseek-ai/DeepSeek-V3.2）。填错则 /api/ask 返回 404 未知模型。
DEEPSEEK_API_KEY=sk-在这里填入硅基流动的APIKey
DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1
DEFAULT_MODEL=deepseek-chat

# 其他模型按需添加（对应 models.yaml 里的条目，key 从这里读）：
# DASHSCOPE_API_KEY=sk-xxxx        # 通义千问
# ZHIPU_API_KEY=sk-xxxx            # 智谱 GLM
# MOONSHOT_API_KEY=sk-xxxx         # Kimi

# ===== Embedding（硅基流动 Qwen3-Embedding-8B，维度固定 1024）=====
SILICONFLOW_API_KEY=sk-在这里填入硅基流动的APIKey
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSIONS=1024

# ===== 向量库 =====
CHROMA_PERSIST_DIR=./chroma_db

# ===== 检索参数 =====
DEFAULT_TOP_K=5
# 相关性阈值：低于此相似度的片段不送入 LLM（防编造）。值域 0~1，越低越宽松
RELEVANCE_THRESHOLD=0.35

# ===== 账户体系（2026-09-01 起；缺 JWT_SECRET 后端启动即报错）=====
# JWT 签名密钥：必须是随机长串（HMAC-SHA256 建议 32 字节）。
# 生成：openssl rand -hex 32   —— 弱密钥可被伪造登录凭证，务必替换本占位值
JWT_SECRET=请用 openssl rand -hex 32 生成后替换
JWT_EXPIRES_DAYS=7

# 注册邀请码：为空 = 一律禁止注册（安全默认）；非空时注册必须提交匹配的码
REGISTER_INVITE_CODE=family-invite-code

# 系统管理员引导密码：配置后启动时若无 admin 用户则自动创建（is_admin=1，
# 上传/删除教材等高风险操作专属）。为空 = 不创建管理员，届时无人可上传/删除教材
ADMIN_PASSWORD=请设置一个强密码